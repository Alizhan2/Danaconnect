# Local development only. Copy to .env; never commit the actual file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./danaconnect.db
DATABASE_POOL_MODE=queue
VERCEL=false
TRUSTED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
DEMO_MODE=true
AUTH_DEBUG_CODE=true
AUTH_SECRET=local-development-change-before-deployment
STORAGE_PROVIDER=local
# Optional private Vercel Blob; use STORAGE_PROVIDER=blob and a private store.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# For PostgreSQL development after starting the optional database container:
# DATABASE_URL=postgresql+psycopg://danaconnect:local-dev-only@127.0.0.1:5432/danaconnect

# Production must use ENVIRONMENT=production, DEMO_MODE=false,
# AUTH_DEBUG_CODE=false, a fresh AUTH_SECRET, HTTPS trusted origins,
# real delivery, approved document content and the deployment checklist.
