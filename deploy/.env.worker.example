# External DB worker only: copy privately to .env.worker on the Docker host.
# Values must match the Vercel API environment; do not create new encryption keys.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST/REPLACE_DB?sslmode=require
TRUSTED_ORIGINS=["https://REPLACE_REAL_DOMAIN"]
FRONTEND_URL=https://REPLACE_REAL_DOMAIN
DEMO_MODE=false
AUTH_DEBUG_CODE=false
AUTH_SECRET=
OUTBOX_ENCRYPTION_KEY=
OUTBOX_PREVIOUS_ENCRYPTION_KEYS=[]
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TLS=false
STORAGE_PROVIDER=s3
# Alternative: STORAGE_PROVIDER=blob; reuse API's private store and token.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_SSE=AES256
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
