# DanaConnect Vercel production configuration. This file contains no credentials.
# Generate a PRIVATE .env.*.local copy with vercel_config.py generate --output PATH.
# Fill values manually; validate is offline and cannot verify resources/permissions.
# API and external worker MUST share DB/auth/outbox/email/storage values.
# Never generate new outbox keys for a worker attached to the same database.
# No automatic env upload, linking, deployment, provisioning or paid resources.
# Keep production credentials out of Preview/Development and NEXT_PUBLIC_* variables.

ENVIRONMENT=production
VERCEL=true
DATABASE_POOL_MODE=null
DEMO_MODE=false
AUTH_DEBUG_CODE=false
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST/REPLACE_DB?sslmode=require
TRUSTED_ORIGINS=["https://REPLACE_REAL_DOMAIN"]
FRONTEND_URL=https://REPLACE_REAL_DOMAIN
AUTH_SECRET=
SESSION_DAYS=7
OTP_MINUTES=10
OTP_MAX_ATTEMPTS=5
ADMIN_MFA_MINUTES=5
OUTBOX_ENCRYPTION_KEY=
OUTBOX_PREVIOUS_ENCRYPTION_KEYS=[]
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LEASE_SECONDS=120
# Generated even with external_worker; enabling a cron is a separate manual action.
CRON_SECRET=

# One verified sender/provider; credentials are not confirmed by offline validation.
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TLS=false

# Private Vercel Blob or S3. The Blob store MUST be created with access private.
# CLI store_<id> and hostname <id> are accepted; token must match the same store.
STORAGE_PROVIDER=blob
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# S3 alternative: set STORAGE_PROVIDER=s3 and fill S3/AWS fields below instead.
S3_BUCKET=
S3_REGION=
# Optional: empty uses AWS; a custom endpoint must be an external HTTPS URL.
S3_ENDPOINT_URL=
S3_SSE=AES256
S3_KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Leave BOTH access-key fields blank for a deliberately configured native role.
# Offline checks cannot prove that the role exists or has private bucket access.
# Keep multipart request below the serverless body ceiling; root reviews this limit.
UPLOAD_MAX_BYTES=3145728

# Optional Google sign-in; all three fields must be filled together if enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# AI disabled until a separate provider/budget decision; no provider calls here.
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DAILY_USER_LIMIT=10
AI_DAILY_GLOBAL_LIMIT=100
AI_MAX_INPUT_CHARS=6000
AI_MAX_OUTPUT_TOKENS=1600

# Non-secret frontend build settings. No secrets may be added to NEXT_PUBLIC_*.
# API_BASE_URL is a non-secret HTTPS fallback; service routing is configured separately.
API_BASE_URL=https://REPLACE_REAL_DOMAIN
ADMIN_APP_URL=https://REPLACE_REAL_DOMAIN/admin
ADMIN_BASE_PATH=/admin
NEXT_PUBLIC_WEB_URL=https://REPLACE_REAL_DOMAIN

# Operator-only metadata: NOT application Settings, NOT proof of live readiness.
# Select exactly one scheduler: external_worker, vercel_cron or qstash.
# Scheduler creation and activation remain separate operator actions.
OPERATOR_SCHEDULER=external_worker
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# External worker must reuse THIS configuration's secrets; no worker file is generated.
# Agree a monthly host/provider budget manually before purchasing or starting it.
# Private store access, S3 policy/IAM, sender ownership and quotas need live evidence.
