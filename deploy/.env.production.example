# Copy to deploy/.env.production; keep private. Do not use these placeholders live.
APP_DOMAIN=mentorship.example.org
ACME_EMAIL=operator@example.org
RELEASE_TAG=local
POSTGRES_USER=danaconnect
POSTGRES_DB=danaconnect
# Generate a random hex password: safe for interpolation in DATABASE_URL.
POSTGRES_PASSWORD=
AUTH_SECRET=
OUTBOX_ENCRYPTION_KEY=
OUTBOX_PREVIOUS_ENCRYPTION_KEYS=[]
ENVIRONMENT=production
DEMO_MODE=false
AUTH_DEBUG_CODE=false

# Choose one verified real sender/provider.
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TLS=false

# External private object storage, no public bucket URLs.
STORAGE_PROVIDER=s3
# Alternative: STORAGE_PROVIDER=blob with a private Vercel Blob store.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_SSE=AES256
S3_KMS_KEY_ID=
UPLOAD_MAX_BYTES=10485760
# Standard AWS credential chain. Prefer a runtime IAM role where available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional Google sign-in. Configure provider and HTTPS callback together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Container worker does not need a cron secret; leave blank unless using cron.
CRON_SECRET=
